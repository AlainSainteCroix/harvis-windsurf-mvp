{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harvis:result-packet:v1",
  "title": "ResultPacket",
  "description": "Contrat définissant la sortie produite par un agent Harvis pour une tâche donnée.",
  "type": "object",
  "required": ["task_id", "agent_id", "status", "produced_at", "trace", "artifacts"],
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^T-[0-9]{4}-[a-z0-9-]+$"
    },
    "agent_id": {
      "type": "string",
      "description": "Identifiant de l'agent ayant produit ce résultat"
    },
    "status": {
      "type": "string",
      "enum": ["success", "failure", "partial", "skipped"]
    },
    "produced_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "description": "Résumé lisible de ce qui a été fait"
    },
    "trace": {
      "type": "array",
      "description": "Log ordonné des décisions et étapes effectuées",
      "items": {
        "type": "object",
        "required": ["step", "message"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "message": { "type": "string", "minLength": 1 },
          "level": {
            "type": "string",
            "enum": ["info", "warning", "error"],
            "default": "info"
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Fichiers ou sorties produits",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": ["file", "patch", "json", "text"]
          },
          "path": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "error": {
      "type": "object",
      "description": "Présent uniquement si status est 'failure'",
      "required": ["code", "message"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "recoverable": { "type": "boolean" }
      }
    }
  }
}
